# Developed on Windows, executed on Linux. Without this, git hands the cluster
# a .sh file with CRLF endings and it dies with:
#     bad interpreter: /usr/bin/env bash^M
* text=auto

*.sh        text eol=lf
*.sbatch    text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.py        text eol=lf

*.png       binary
*.jpg       binary
*.safetensors binary
